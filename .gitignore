# Dependencies
node_modules/

# Environment and secrets
.env
.env.*
!.env.example
.env.staging
.env.eas.staging
ios/.xcode.env.staging
scripts/market-intel-worker/.env

# Expo and build output
.expo/
.expo-shared/
dist/
build/
ios/build/
android/build/
android/app/build/
DerivedData/
DerivedData-*/
build/DerivedData*/

# Certificates and signing secrets
*.pem
*.key
*.p8
*.mobileprovision

# Build artifacts
*.ipa
build-*.ipa
builds/
bundle-check/
artifacts/

# Local agent / tooling runtime (never commit)
.codex/
.cursor/plans/
*.bak
scripts/*.bak

# Transient QA screenshot dumps (approved reports stay as .md)
docs/releases/**/phase4f-screenshots/
docs/releases/**/first-launch-evidence/
docs/releases/**/simulator-recovery/
docs/releases/**/stats-redesign-evidence/
docs/releases/**/qa-logs/

# Backups and temporary generated files
*.before-*
recovery-backups/
review-fix-backups/
supabase/.temp/
knowledge/sources/.last-import.json
scripts/ai-platform-v2/backups/
scripts/ai-platform-v2/reports/
scripts/release-command-center/reports/

# Local agent worktrees (not part of app releases)
.worktrees/
.parallel-code/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug-storybook.log

# Editor and OS files
*.swp
.DS_Store

# Local Cursor MCP config (may contain access tokens)
.cursor/mcp.json

*storybook.log
storybook-static

# Maestro / Storybook capture scratch (committed baselines live in .maestro/ydl/baselines/)
.maestro/ydl/.capture-out/

.tmp/

# Local agent secrets (never commit)
.codex/secrets/

# Credential / password artifacts (never commit; use Keychain or .codex/secrets/)
**/SIM_EMAIL_PASSWORD*
**/*PASSWORD_UNIT.txt
**/*credentials.env
**/staging-qa-credentials.env
docs/releases/**/*PASSWORD*
docs/releases/**/*SECRET*
docs/releases/**/*credential*.txt

# Project-local tooling (JDK archives, Maestro QA logs)
.tools/
docs/releases/**/qa-artifacts/
.maestro/.qa-out/
