{
  "name": "youtrader-pro",
  "version": "1.6.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "typecheck": "tsc --noEmit",
    "test:export-rate-limit": "npx tsx scripts/export-rate-limit-qa.ts",
    "test:email-password": "npx tsx scripts/email-password-qa.ts",
    "test:usage-limits": "npx tsx scripts/usage-limits-qa.ts",
    "test:session-storage": "node --experimental-strip-types scripts/security/session-storage-qa.ts",
    "test:release-readiness": "npx tsx scripts/release-readiness-qa.ts",
    "market-intel": "node scripts/market-intel-worker/index.mjs all",
    "market-intel:news": "node scripts/market-intel-worker/index.mjs news",
    "market-intel:brief": "node scripts/market-intel-worker/index.mjs daily-brief",
    "market-intel:watchlist": "node scripts/market-intel-worker/index.mjs watchlist",
    "market-intel:summary": "node scripts/market-intel-worker/index.mjs summary",
    "market-intel:prop-firms": "node scripts/market-intel-worker/index.mjs prop-firms",
    "market-intel:calendar": "node scripts/market-intel-worker/index.mjs calendar",
    "market-intel:daily-brief": "node scripts/market-intel-worker/index.mjs daily-brief",
    "rag:import": "node scripts/rag/import-knowledge.mjs",
    "security:check": "node scripts/security-check.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:gitleaks": "gitleaks detect --no-git --source . --config .gitleaks.toml --redact",
    "security:gitleaks:history": "gitleaks detect --source . --config .gitleaks.toml --redact",
    "security:semgrep": "semgrep scan --config auto --severity ERROR --exclude node_modules --exclude dist --exclude ios/Pods --exclude ios/build --exclude android/build --exclude recovery-backups",
    "security:all": "npm run security:check && npm run security:audit && npm run security:gitleaks && npm run security:semgrep",
    "release:stability": "node scripts/release-stability-check.mjs",
    "translations:check": "node scripts/check-translations.mjs",
    "test:maestro": "maestro test .maestro",
    "test:maestro:launch": "maestro test .maestro/01_app_launch.yaml",
    "test:ai-safety": "npx promptfoo@latest eval -c promptfoo.config.yaml",
    "ai-platform:validate": "node scripts/ai-platform-v2/validate-pipeline.mjs",
    "ai-platform:validate:report": "node scripts/ai-platform-v2/validate-pipeline.mjs --write-doc",
    "ai-platform:benchmark": "node scripts/ai-platform-v2/run-benchmark.mjs",
    "ai-platform:readiness": "node scripts/ai-platform-v2/production-readiness-gate.mjs",
    "ai-platform:readiness:report": "node scripts/ai-platform-v2/production-readiness-gate.mjs --write-doc",
    "ai-platform:backup": "node scripts/ai-platform-v2/backup-ai-config.mjs",
    "ai-platform:preview-deploy": "node scripts/ai-platform-v2/preview-deploy.mjs",
    "ai-platform:preview-report": "node scripts/ai-platform-v2/generate-preview-report.mjs",
    "ai-platform:verify-db-permissions": "node scripts/ai-platform-v2/verify-db-permissions.mjs",
    "prepare:testflight": "node scripts/release-command-center/run.mjs testflight",
    "prepare:production": "node scripts/release-command-center/run.mjs production",
    "prepare:release": "node scripts/release-command-center/run.mjs release",
    "test:local-ai-cache": "npx tsx scripts/local-ai-cache-qa.ts",
    "test:revenge-trading": "npx tsx scripts/revenge-trading-qa.ts",
    "test:ui-infra-phase3": "node --experimental-strip-types --experimental-transform-types scripts/ui-infra-phase3-qa.ts",
    "test:ui-infra-phase4": "node --experimental-strip-types --experimental-transform-types scripts/ui-infra-phase4-qa.ts",
    "test:ui-infra-phase5": "node --experimental-strip-types --experimental-transform-types scripts/ui-infra-phase5-qa.ts",
    "test:ui-infra-phase6": "node --experimental-strip-types --experimental-transform-types scripts/ui-infra-phase6-qa.ts",
    "test:prop-os-types": "tsc -p tsconfig.prop-os.json --noEmit",
    "test:prop-os-fixtures": "npm run test:prop-os-types && node --import ./scripts/prop-os-register.mjs --experimental-strip-types --experimental-transform-types scripts/prop-os-fixtures-qa.ts",
    "test:prop-os-invariants": "npm run test:prop-os-types && node --import ./scripts/prop-os-register.mjs --experimental-strip-types --experimental-transform-types scripts/prop-os-invariants-qa.ts",
    "test:prop-os-engine": "npm run test:prop-os-fixtures && npm run test:prop-os-invariants",
    "gen:prop-os-db-types": "node --experimental-strip-types --experimental-transform-types scripts/generate-prop-os-db-types.ts",
    "gen:prop-os-db-types:live": "node --experimental-strip-types --experimental-transform-types scripts/generate-prop-os-db-types-live.ts",
    "test:prop-os-schema": "npm run gen:prop-os-db-types && node --experimental-strip-types --experimental-transform-types scripts/prop-os-schema-static-qa.ts",
    "test:prop-os-schema-drift": "node --experimental-strip-types --experimental-transform-types scripts/prop-os-schema-drift-qa.ts",
    "test:prop-os-schema-live": "bash scripts/prop-os-phase1a-live-validate.sh",
    "storybook:start": "cross-env STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true expo start --android",
    "lint:ui-infra": "eslint --config eslint.ui-infra.config.mjs .rnstorybook src/ydl/haptics.ts src/ydl/sheets src/ydl/lottie src/ydl/symbols src/ydl/accessibility src/ydl/components src/ydl/motion src/ydl/tokens src/components/ui/haptics.ts src/components/stats/MetricExplanationSheet.tsx src/components/stats/StatsPerformanceRadar.tsx index.js && eslint --config eslint.ui-infra-imports.config.mjs \"src/**/*.{ts,tsx}\" App.tsx index.js"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "2.75.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.9",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.9",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.3.4",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "^1.21.0",
    "posthog-react-native": "^4.53.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.2.8",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.32.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@storybook/addon-ondevice-actions": "10.5.1",
    "@storybook/addon-ondevice-controls": "10.5.1",
    "@storybook/react-native": "10.5.1",
    "@storybook/react-native-ui-lite": "10.5.1",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "storybook": "10.5.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "js-yaml": "^4.3.0",
    "uuid": "^11.1.1",
    "@storybook/react-native-ui": "10.5.1",
    "@storybook/react-native-ui-common": "10.5.1",
    "@storybook/react-native-theming": "10.5.1",
    "@storybook/react": "10.5.1",
    "@storybook/react-dom-shim": "10.5.1"
  }
}
