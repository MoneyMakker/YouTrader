# Copy to ios/.xcode.env.staging (gitignored) for Release-Staging Xcode builds.
# Used by the "Bundle React Native code and images" script when CONFIGURATION contains "Staging".
# Do NOT commit real secrets — fill values from your staging Supabase / RevenueCat / Google projects.

export EXPO_PUBLIC_APP_ENV=staging

# Staging Supabase (NOT production)
export EXPO_PUBLIC_SUPABASE_URL=
export EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Prop OS controlled activation — staging_preview + allowlist (not production "off")
export EXPO_PUBLIC_PROP_OS_ACTIVATION_MODE=staging_preview
export EXPO_PUBLIC_PROP_OS_ALLOWLIST=

# Google native Sign-In (staging OAuth clients)
export EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
export EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Apple: staging Supabase often has Apple provider disabled (provider_disabled).
# Leave unset to hide the Apple button. Set true only after enabling Apple on staging
# with Client ID = com.youtrader.pro (Services ID not required for native id_token).
# EXPO_PUBLIC_ENABLE_NATIVE_APPLE_SIGN_IN=true

# RevenueCat public keys (staging / sandbox project)
export EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
export EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
export EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=YouTrader Pro
export EXPO_PUBLIC_REVENUECAT_IOS_PRODUCT_ID=
export EXPO_PUBLIC_REVENUECAT_IOS_YEARLY_PRODUCT_ID=
